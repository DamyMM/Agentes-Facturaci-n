# Claude (o usar `ant auth login`)
ANTHROPIC_API_KEY=

# Odoo (XML-RPC). Usar una API key de un usuario con permisos de facturación,
# idealmente uno dedicado al agente para que quede trazado quién creó cada borrador.
ODOO_URL=https://harborgateway.odoo.com
ODOO_DB=harborgateway
ODOO_USER=agente.facturacion@harborgateway.com.ar
ODOO_API_KEY=

# Google Sheets/Drive: cuenta de servicio con acceso de LECTURA a las planillas
GOOGLE_APPLICATION_CREDENTIALS=/ruta/service-account.json

# Tope de gasto por solicitud (USD, centavos como string). 500 = USD 5,00
SESSION_BUDGET_USD_CENTS=500
